# Сборка PyInstaller
build/
dist/
*.spec
# SI-HYX.spec — не автогенерат, а вручную поддерживаемый единый источник
# правды для build.bat (datas/hiddenimports/excludes) — держим в git.
!SI-HYX.spec

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Внешние бинарники (большие, кладутся в релиз-архив, не в репозиторий)
bin/
# Модель LaMa (~200 МБ) — тоже в релиз-архив, а не в git
models/

# Локальные/служебные файлы
settings.json
*.log
*.log.[1-9]*
*_original_backup.py
# Случайный лог-маркер сборки build.bat (echo «Version: … -> …» в файл)
SI-HYX v*
YouTubecookies.txt
*cookies*.txt

/artifacts/
# Локальные прогоны: логи, карточки тайтлов, измерения и заметки с путями ПК.
/reports/
# Пустая локальная заготовка ручного стенда.
/tools/karaoke_balanced_pack.py
# Датированные заметки сессий (аудиты, замеры, анализы) — локальные отчёты.
/docs/*-20??-??-??.md
# Рабочие папки прогонов и проверок (видео, кадры, json ответов API).
/tmp/
# Ключи, личные данные и локальные хранилища восстановления.
.env
.env.*
!.env.example
!.env.template
/animepack_recovery/
/animepack_*.json
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# sigstats: локальный кэш/данные (см. sigstats/config.py, BASE_DIR)
/media/
/packages/
/sigstats.db
/author_blacklist.json
/package_blacklist.json
/package_blacklist_added_at.json
/played_packages.json
/played_packages_added_at.json
/search_page_cache.json
/ui_settings.json

# Локальный кэш wrangler (в т.ч. слепок cf-запроса с IP/геоданными) — деплой
# воркеров идёт из CLI, в репозитории этому файлу делать нечего.
.wrangler/

# Временные файлы сторонних утилит (ab-av1 и т.п.)
.ab-av1-*/

# Локальные настройки и рабочие копии ИИ-агентов (Claude Code и др.)
.claude/
.codex/
.cursor/
.gemini/
.aider*
.continue/
.windsurf/
.mcp.json
.cursorrules
.windsurfrules
# Инструкции и памятки для ИИ-агентов — только на машине разработчика.
/AGENTS.md
/CLAUDE.md
/CLAUDE.local.md
/GEMINI.md
/CODE_MAP.md
/.github/copilot-instructions.md
/docs/montage-agent-amv.md
/docs/amv-playbook.md
# Стили AMV (разборы эталонных клипов) — личные заготовки, не в репозиторий.
/docs/amv-styles/

# Отдельные локальные страницы, не входящие в приложение.
/anime_genre_game.html
/anime-scene-3d.html

# Локальные данные и скрипты разовых проверок (Letterboxd-экспорт и т.п.)
*.csv
/find_anime_matches.py

# Разовая сверка Letterboxd/Shikimori: скрипты поиска и их выгрузки.
/check_lb_cache.py
/find_specific_anime.py
/parse_csv.py
/search_scissor*.py
/search_target_anime.py
/cache_matches.json
/found_anime.txt
/matches_log.txt
/target_anime_found.json

# Временные папки ручных проверок (.tmp_pixiv_live_check и т.п.)
.tmp*/
*.tmp
*.bak

# Локальная dev-надстройка настроек («Библиотеки»: проверка и обновление пакетов
# через PyPI/pip). Живёт только на машине разработчика: не на GitHub и не в релизе.
_local_dev.py

# Редакторы и ОС
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
.DS_Store
